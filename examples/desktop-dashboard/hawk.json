{
  "$schema": "https://hawk2ui.dev/schemas/hawk.schema.json",
  "schemaVersion": 1,
  "package": {
    "id": "com.hawk2ui.examples.desktop-dashboard",
    "name": "Hawk2UI Desktop Dashboard",
    "version": "0.1.0",
    "bundleId": "com.hawk2ui.examples.desktop-dashboard"
  },
  "app": {
    "entry": "src/main.ts",
    "style": "styles/main.hawk.css"
  },
  "targets": {
    "desktop": [
      {
        "name": "linux-wayland"
      }
    ]
  },
  "permissions": {
    "capabilities": [
      "native-windowing",
      "sealed-artifacts"
    ]
  }
}
