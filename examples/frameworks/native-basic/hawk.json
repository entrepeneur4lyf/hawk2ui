{
  "$schema": "https://hawk2ui.dev/schemas/hawk.schema.json",
  "schemaVersion": 1,
  "package": {
    "id": "com.hawk2ui.examples.native-basic",
    "name": "Hawk2UI Native Basic",
    "version": "0.1.0",
    "bundleId": "com.hawk2ui.examples.native-basic"
  },
  "app": {
    "entry": "src/app.ts",
    "framework": "native",
    "style": "styles/main.hawk.css"
  },
  "targets": {
    "desktop": [
      {
        "name": "linux-wayland"
      }
    ]
  },
  "permissions": {
    "capabilities": [
      "native-windowing",
      "sealed-artifacts"
    ]
  }
}
