{
  "$schema": "https://hawk2ui.dev/schemas/hawk.schema.json",
  "schemaVersion": 1,
  "package": {
    "id": "com.hawk2ui.examples.vue-desktop-basic",
    "name": "Hawk2UI Vue Desktop Basic",
    "version": "0.1.0",
    "bundleId": "com.hawk2ui.examples.vue-desktop-basic"
  },
  "app": {
    "entry": "src/main.ts",
    "framework": "vue",
    "style": "styles/main.hawk.css"
  },
  "build": {
    "packageManager": "bun",
    "output": "dist/main.js"
  },
  "targets": {
    "desktop": [
      {
        "name": "linux-wayland",
        "platforms": ["windows", "macos", "linux-wayland", "linux-x11"],
        "window": {
          "title": "Hawk2UI Vue Desktop Basic",
          "width": 960,
          "height": 540
        }
      }
    ]
  },
  "permissions": {
    "capabilities": [
      "native-windowing",
      "sealed-artifacts",
      "network",
      "storage",
      "files"
    ]
  }
}
