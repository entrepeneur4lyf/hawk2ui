{
  "$schema": "https://hawk2ui.dev/schemas/hawk.schema.json",
  "schemaVersion": 1,
  "package": {
    "id": "com.hawk2ui.examples.plugin-meter-analyzer",
    "name": "Hawk2UI Plugin Meter Analyzer",
    "version": "0.1.0",
    "bundleId": "com.hawk2ui.examples.plugin-meter-analyzer"
  },
  "app": {
    "entry": "src/editor.ts"
  },
  "targets": {
    "plugin": [
      {
        "name": "clap-vst3",
        "editor": {
          "width": 960,
          "height": 540
        }
      }
    ]
  },
  "plugin": {
    "id": "com.hawk2ui.examples.plugin-meter-analyzer",
    "name": "Hawk2UI Plugin Meter Analyzer"
  },
  "permissions": {
    "capabilities": [
      "plugin-editor",
      "realtime-visuals"
    ]
  }
}
