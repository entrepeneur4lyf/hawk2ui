{
  "name": "hawk2ui-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/hawk2ui-native",
    "packages/hawk2ui-svelte",
    "packages/hawk2ui-react",
    "packages/hawk2ui-vue",
    "packages/hawk2ui-solid",
    "packages/hawk2ui-compiler"
  ],
  "scripts": {
    "test:react-package": "bun test packages/hawk2ui-react/test/react-reconciler.test.ts packages/test/react-production-api.test.ts",
    "test:vue-package": "bun test packages/hawk2ui-vue/test/vue-runtime-renderer.test.ts packages/test/framework-production-api.test.ts",
    "test:packages": "bun test packages/hawk2ui-native/test/native-records.test.ts packages/hawk2ui-svelte/test/svelte-compile.test.ts packages/hawk2ui-react/test/react-reconciler.test.ts packages/hawk2ui-vue/test/vue-renderer.test.ts packages/hawk2ui-vue/test/vue-runtime-renderer.test.ts packages/hawk2ui-solid/test/solid-renderer.test.ts packages/hawk2ui-compiler/test/compiler.test.ts packages/test/framework-production-api.test.ts",
    "typecheck:react-package": "tsc -p tsconfig.react-package.json --noEmit",
    "typecheck:vue-package": "tsc -p tsconfig.vue-package.json --noEmit",
    "typecheck:packages": "tsc -p tsconfig.packages.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@hawk2ui/native": "workspace:*",
    "@hawk2ui/react": "workspace:*",
    "@hawk2ui/vue": "workspace:*",
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.7",
    "@babel/parser": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/react": "19.2.17",
    "@types/react-reconciler": "0.33.0",
    "@vue/compiler-dom": "3.5.35",
    "@vue/compiler-sfc": "3.5.35",
    "babel-preset-solid": "1.9.12",
    "react": "19.2.7",
    "react-reconciler": "0.33.0",
    "svelte": "5.56.2",
    "typescript": "6.0.3",
    "vue": "3.5.35"
  }
}
